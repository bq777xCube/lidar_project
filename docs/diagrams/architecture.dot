// Редактируемый исходник схемы. Рендеринг: dot -Tsvg файл.dot -o файл.svg
digraph G {
  graph [bgcolor="white", pad="0.28", nodesep="0.34", ranksep="0.62", splines=polyline, fontname="DejaVu Sans", fontsize=18, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#F5F0FA", color="#7745A0", penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.17,0.13"];
  edge [color="#755589", penwidth=1.5, arrowsize=0.75, fontname="DejaVu Sans", fontsize=10, fontcolor="#51475A"];
  rankdir=TB;
  input [label="PointCloud2\nПоток 3D-лидара", fillcolor="#EAF1FA", color="#426C9E"];
  xyz [label="Проверка формата\nXYZ по метаданным"];
  near [label="Геометрия пути\nРельсы · габарит · маски"];
  normal [label="Основные кандидаты\nи подтверждение S2"];
  handoff [label="Поддержка при приближении\nИзмеренная и переходная области"];
  far [label="Дальний синтетический канал\nСтруктура лучей · номинальная область"];
  merge [label="Объединение подтверждений\nВыбор расстояния и источника", fillcolor="#E7F4F0", color="#368475"];
  out [label="7 выходов ROS 2\nПрепятствие · расстояние\nсостояние · диагностика", fillcolor="#EAF1FA", color="#426C9E"];
  input -> xyz;
  {rank=same; normal; handoff;}
  xyz -> near; xyz -> far;
  near -> normal; near -> handoff [label="текущий контекст"];
  normal -> merge; handoff -> merge; far -> merge;
  merge -> out;
}
